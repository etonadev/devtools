# Public production origin used for canonical URLs and sitemap generation.
# Leave unset in local development. Set this in Cloudflare Pages for production.
VITE_SITE_URL=https://your-domain.example

# Optional temporary product-name override.
VITE_PRODUCT_NAME=DevTools

# Analytics is off unless this is explicitly true, and it always remains off in local development.
VITE_ANALYTICS_ENABLED=false

# Google Analytics 4 web-stream Measurement ID (format: G-XXXXXXXXXX).
VITE_GA4_MEASUREMENT_ID=

# Token from a manually configured Cloudflare Web Analytics site.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
